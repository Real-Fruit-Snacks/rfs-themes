<?xml version="1.0" encoding="utf-8"?>
<!--
  Cyclorama Dawn (LX 263 · Beacon Orange) — Flow Launcher WPF XAML Theme
  Author: Real-Fruit-Snacks · Cyclorama Dawn v2.3.2
  Source: https://github.com/Real-Fruit-Snacks/rfs-themes
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/Base.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Selected Row Background Brush -->
    <SolidColorBrush x:Key="ItemSelectedBackgroundColor" Color="#FF38241C" />

    <!-- Base Query TextBox -->
    <Style x:Key="BaseQueryTextBoxStyle" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="#FF14141A" />
        <Setter Property="Foreground" Value="#FFF4F5F8" />
        <Setter Property="CaretBrush" Value="#FFF06E2B" />
        <Setter Property="SelectionBrush" Value="#FF3D2B24" />
        <Setter Property="BorderBrush" Value="#FF2A2C35" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Padding" Value="6,4" />
    </Style>

    <!-- Active Query Input Box -->
    <Style x:Key="QueryBoxStyle" BasedOn="{StaticResource BaseQueryTextBoxStyle}" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#FFF4F5F8" />
        <Setter Property="CaretBrush" Value="#FFF06E2B" />
        <Setter Property="SelectionBrush" Value="#FF3D2B24" />
    </Style>

    <!-- Autocomplete Suggestion Overlay -->
    <Style x:Key="QuerySuggestionBoxStyle" BasedOn="{StaticResource BaseQueryTextBoxStyle}" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#FF8C8F9D" />
    </Style>

    <!-- Outer Spotlight Frame & Window -->
    <Style x:Key="WindowBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#F5050507" />
        <Setter Property="BorderBrush" Value="#FF62646D" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="WindowStyle" TargetType="{x:Type Window}">
        <Setter Property="Background" Value="#F5050507" />
        <Setter Property="Foreground" Value="#FFF4F5F8" />
        <Setter Property="Width" Value="620" />
    </Style>

    <!-- Pending Activity Accent Line -->
    <Style x:Key="PendingLineStyle" TargetType="{x:Type Line}">
        <Setter Property="Stroke" Value="#FFFF9254" />
        <Setter Property="StrokeThickness" Value="2" />
    </Style>

    <!-- Result Item Typography -->
    <Style x:Key="ItemTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#FFD6D8E0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ItemSubTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#FFB3B5C0" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="ItemTitleSelectedStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#FFF4F5F8" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="ItemSubTitleSelectedStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#FFFF9254" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Match Highlight & Divider -->
    <Style x:Key="HighlightStyle" TargetType="{x:Type Run}">
        <Setter Property="Foreground" Value="#FFFF9254" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="SeparatorStyle" TargetType="{x:Type Rectangle}">
        <Setter Property="Fill" Value="#FF2A2C35" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="12,4,12,4" />
    </Style>

    <!-- Scrollbar & Thumb -->
    <Style x:Key="ThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Background" Value="#CC62646D" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarStyle" TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="#FF070709" />
        <Setter Property="Width" Value="6" />
        <Setter Property="Margin" Value="0,4,4,4" />
    </Style>

    <!-- Clock & Date Readout -->
    <Style x:Key="ClockBox" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#FF74B8E8" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="DateBox" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#FFB3B5C0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
