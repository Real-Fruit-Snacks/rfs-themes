    "diffEditor.removedTextBackground": "#FF5C6C2B",
    "diffEditor.insertedLineBackground": "#0D291ECC",
    "diffEditor.removedLineBackground": "#301218CC",
    "diffEditor.diagonalFill": "#222B36",
    "diffEditor.border": "#27313D",
    "peekView.border": "#74B8E8",
    "peekViewEditor.background": "#080A0E",
    "peekViewResult.background": "#0C0C10",
    "peekViewTitle.background": "#07080B",
    "quickInput.background": "#0C0C10",
    "quickInput.foreground": "#F4F5F8",
