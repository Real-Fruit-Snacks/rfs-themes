{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "palette": {
    "bg": "#F5F7F9",
    "surface": "#FFFFFF",
    "raised": "#E3E8EE",
    "border": "#C8D0DA",
    "text": "#0D1016",
    "text_soft": "#252A34",
    "mute": "#474D59",
    "subtle": "#58606E",
    "accent": "#AD3D0A",
    "accent_vivid": "#CC5016",
    "accent_fill": "#18496B",
    "on_accent": "#FFFFFF",
    "secondary": "#164669",
    "secondary_fill": "#AD3D0A",
    "signal": "#127247",
    "warning": "#885800",
    "fault": "#B91C2E",
    "fault_fill": "#B91C2E",
    "cyan": "#0E6674",
    "magenta": "#6B38B8"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:on_accent",
          "background": "p:secondary_fill",
          "template": " {{ .Path }} ",
          "properties": {
            "style": "folder",
            "max_depth": 3
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:on_accent",
          "background": "p:accent_fill",
          "template": " git:{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} ~{{ .Working.String }}{{ end }}{{ if .Staging.Changed }} +{{ .Staging.String }}{{ end }} ",
          "properties": {
            "fetch_status": true,
            "fetch_upstream_icon": false
          }
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "p:signal",
          "background": "p:raised",
          "template": " py {{ if .Venv }}({{ .Venv }}) {{ end }}{{ .Full }} ",
          "properties": {
            "display_mode": "files",
            "fetch_virtual_env": true
          }
        },
        {
          "type": "rust",
          "style": "plain",
          "foreground": "p:warning",
          "background": "p:raised",
          "template": " rs {{ .Full }} ",
          "properties": {
            "display_mode": "files"
          }
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "p:cyan",
          "background": "p:raised",
          "template": " node {{ .Full }} ",
          "properties": {
            "display_mode": "files"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:mute",
          "background": "p:raised",
          "template": " {{ .FormattedMs }} ",
          "properties": {
            "threshold": 500,
            "style": "roundrock"
          }
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:signal",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:fault{{ end }}"
          ],
          "background": "p:raised",
          "template": " {{ if gt .Code 0 }}exit {{ .Code }}{{ else }}ok{{ end }} ",
          "properties": {
            "always_enabled": true
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:accent",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:fault{{ end }}"
          ],
          "template": ">"
        }
      ]
    }
  ]
}
