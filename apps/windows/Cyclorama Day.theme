Pattern=
MultimonBackgrounds=0
PicturePosition=4

[Control Panel\Colors]
Background=245 247 249

[VisualStyles]
Path=%SystemRoot%\resources\themes\Aero\Aero.msstyles
ColorStyle=NormalColor
Size=NormalSize
AutoColorization=0
ColorizationColor=0xC4AD3D0A
VisualStyleVersion=10
SystemMode=Light
AppMode=Light

[MasterThemeSelector]
MTSM=RJSPBS

[boot]
SCRNSAVE.EXE=
