# Cyclorama Steel (LX 263 Dark · Steel Blue) — Native Git CLI Truecolor Theme
# Author: Real-Fruit-Snacks | Brand: Cyclorama Dawn v2.1.0
# Source: https://github.com/Real-Fruit-Snacks/rfs-themes
# Include from ~/.gitconfig via [include] path = ...

[color]
	ui = auto

[color "diff"]
	meta = "#FF9254 bold"
	frag = "#56D4E0 bold"
	old = "#FF5C6C"
	new = "#3DDC97"
	context = "#B3B5C0"
	whitespace = "#FFFFFF #C92438"
	func = "#74B8E8"

[color "status"]
	header = "#B3B5C0"
	added = "#3DDC97 bold"
	changed = "#FFC247 bold"
	untracked = "#74B8E8"
	branch = "#FF9254 bold"
	nobranch = "#FF5C6C bold"

[color "branch"]
	current = "#74B8E8 bold"
	local = "#F4F5F8"
	remote = "#FF9254"
	upstream = "#3DDC97"

[color "grep"]
	filename = "#FF9254 bold"
	linenumber = "#8C96A6"
	match = "#FFFFFF #18496B bold"
	separator = "#B3B5C0"
